        "POST /api/auth/register",
        "POST /api/auth/login",
        "GET /api/auth/me"
      ],
      "files": [
        "routes/auth.js",
        "controllers/authController.js",
        "middleware/auth.js",
        "models/User.js"
      ],
      "keyFunctions": [
        "register",
        "login",
        "me",
        "signToken",
        "auth",
        "optionalAuth"
      ],
      "externalDependencies": [
        "bcrypt@^6.0.0",
        "jsonwebtoken@^9.0.3",
        "express@^5.2.1"
      ],
      "internalDependencies": [
        "models/User.js",
        "utils/httpError.js",
        "utils/asyncHandler.js"
      ],
      "dataAccess": {
        "reads": [
          "users"
        ],
        "writes": [
          "users"
        ]
