        "GET /api/me/questions/starred"
      ],
      "files": [
        "controllers/progressController.js",
        "routes/questions.js",
        "routes/me.js",
        "models/UserQuestionState.js"
      ],
      "keyFunctions": [
        "getState",
        "solve",
        "unsolve",
        "setStar",
        "removeStar",
        "listSolved",
        "listStarred"
      ],
      "externalDependencies": [
        "mongoose@^9.9.5"
      ],
      "internalDependencies": [
        "models/UserQuestionState.js",
        "models/Question.js",
        "services/questionCatalog.js",
        "utils/httpError.js"
      ],
      "dataAccess": {
        "reads": [
          "userquestionstates",
          "questions"
        ],
        "writes": [
          "userquestionstates"
        ]
      },
      "knownEdgeCases": [
        "solve() and unsolve() currently throw HTTP 403 because manual solving was locked in favor of account sync.",
