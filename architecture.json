        ],
        "writes": [
          "questions"
        ]
      },
      "knownEdgeCases": [
        "Junk tags are filtered out using isJunkTag regex; tag aliases are mapped canonically (e.g. dynamic programming -> dp).",
        "Non-ObjectId slugs are resolved dynamically to ObjectIds in middleware/validateObjectId.js."
      ]
    },
