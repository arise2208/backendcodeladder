        "services/questionCatalog.js",
        "routes/questions.js",
        "controllers/questionController.js",
        "middleware/validateObjectId.js",
        "models/Question.js"
      ],
      "keyFunctions": [
        "QuestionCatalog.getPaginatedQuestions",
        "QuestionCatalog.getTags",
        "QuestionCatalog.getQuestionById",
        "QuestionCatalog.getQuestionByPlatformAndExternalId",
        "listQuestions",
        "getTags",
        "getQuestion",
        "createQuestion",
        "updateQuestion",
        "deleteQuestion",
        "importBulkQuestions"
      ],
      "externalDependencies": [
        "mongoose@^9.9.5"
      ],
      "internalDependencies": [
        "models/Question.js",
        "services/questionCatalog.js",
        "utils/httpError.js",
        "utils/asyncHandler.js"
