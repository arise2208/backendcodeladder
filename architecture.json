  "directories": [
    {
      "path": "controllers/",
      "role": "Business logic implementations decoupled from HTTP routing."
    },
    {
      "path": "data/",
      "role": "Pre-packaged dataset seed files for bootstrap and offline catalog operations."
    },
    {
      "path": "middleware/",
      "role": "Express request pipeline filters, security checks, and rate limiters."
    },
    {
      "path": "models/",
      "role": "Mongoose schemas, validation rules, and collection indices."
    },
    {
      "path": "routes/",
      "role": "Express route definitions mapping HTTP paths to controllers and middlewares."
    },
    {
      "path": "scripts/",
      "role": "Database maintenance, synchronization, and ETL utilities."
    },
    {
      "path": "services/",
      "role": "Application-wide domain services and caching layers (questionCatalog, defaultLadders)."
    },
    {
      "path": "tests/",
      "role": "Automated integration tests using Jest and Supertest."
    },
    {
      "path": "utils/",
      "role": "Cross-cutting helper functions (asyncHandler, httpError)."
    }
  ],
  "dependencies": {
    "external": {
      "production": {
        "express": "^5.2.1",
        "mongoose": "^9.9.5",
        "jsonwebtoken": "^9.0.3",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express-rate-limit": "^8.7.0"
      },
      "development": {
        "jest": "^29.7.0",
        "supertest": "^7.2.2",
        "nodemon": "^3.1.14"
      }
    },
    "internalCoupling": [
      {
        "source": "middleware/validateObjectId.js",
        "target": "services/questionCatalog.js",
        "reason": "Resolves non-ObjectId slugs to ObjectIds dynamically."
      },
      {
        "source": "services/defaultLadders.js",
        "target": "services/questionCatalog.js",
        "reason": "Hydrates problem metadata for default curated sheets."
      },
      {
        "source": "controllers/ladderController.js",
        "target": "services/defaultLadders.js",
        "reason": "Serves default- prefixed ladders without database queries."
      }
    ]
  },
  "flows": [
    {
      "name": "User Authentication Flow",
      "steps": [
        "Client sends request with Authorization: Bearer <jwt> and X-Username headers",
        "app.js generalLimiter throttles request if limit exceeded",
        "middleware/auth.js verifies JWT signature and validates username match",
        "models/User.js is queried to attach req.user { id, username, role }",
        "Target route controller executes business logic"
      ]
    },
    {
      "name": "Question Catalog Search Flow",
      "steps": [
        "Client sends GET /api/questions with search query, tags, and rating filters",
        "app.js catalogLimiter evaluates rate window",
        "routes/questions.js routes to controllers/questionController.js listQuestions",
        "services/questionCatalog.js performs in-memory filter, slice, and tag count in < 2ms",
        "JSON response returns questions array with pagination metadata"
      ]
    },
    {
      "name": "Platform Solve State Synchronization Flow",
      "steps": [
        "Client sends POST /api/platform-accounts/sync-solved with solved problem titles/slugs",
        "middleware/auth.js authenticates user session",
        "controllers/platformAccountController.js maps slugs to question IDs via questionCatalog",
        "models/UserQuestionState.js executes bulkWrite upsert for solved: true",
        "PlatformAccount.lastSyncedAt timestamp is refreshed in database"
      ]
    }
  ],
  "commands": {
    "install": "npm install",
    "dev": "npm run dev",
    "start": "npm start",
    "test": "npm test",
    "import": "npm run import",
    "buildCatalog": "node scripts/buildCatalog.js",
    "syncCodeforces": "node scripts/syncCodeforcesContests.js",
    "syncCodeChef": "node scripts/syncCodeChefContests.js",
    "syncLeetCode": "node scripts/syncLeetCodeContests.js",
    "setupProxy": "node setup-proxy.js",
    "revertProxy": "node revert-proxy.js"
  }
}
