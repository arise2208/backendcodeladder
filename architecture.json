{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": {
    "name": "backendcodeladder",
    "version": "1.0.0",
    "description": "CodeLadder Competitive Programming Platform REST API and Intelligence Service",
    "runtime": "Node.js 18+",
    "language": "JavaScript (CommonJS)",
