# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/codeladder
# Atlas:
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/codeladder?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED: Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRES_IN=1d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave blank to allow all origins (development only — do NOT leave blank in production).
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Login Brute-Force Lockout ─────────────────────────────────────────────────
# Account locks for LOCK_DURATION_MINUTES after MAX_LOGIN_ATTEMPTS consecutive failures.
MAX_LOGIN_ATTEMPTS=10
LOCK_DURATION_MINUTES=15

# ── Admin Seed (one-time use) ─────────────────────────────────────────────────
# Run: npm run seed:admin
# Only creates admin if no ADMIN user exists yet.
ADMIN_SEED_USERNAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ── Campus Proxy (optional) ───────────────────────────────────────────────────
CAMPUS_PROXY_URL=http://172.31.2.4:8080

# ── Environment ───────────────────────────────────────────────────────────────
# Options: development | test | production
NODE_ENV=development
